+            if cfg:
+                cfg.value = v
+                s.add(cfg)
+            else:
+                s.add(AppConfig(key=cfg_key, value=v))
+        s.commit()
+    print("Mapeos guardados en AppConfig (default_account.<key> = <code>).")
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("path", nargs="?", help="Ruta a catalogo.xlsx (por defecto ./assets/Catálogo.xlsx)")
+    parser.add_argument("--mode", choices=["comercial", "osc", "both"], default="both",
+                        help="Usar columna comercial (C), osc (B), o importar ambos (both).")
+    args = parser.parse_args()
