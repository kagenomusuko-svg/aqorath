+"""
+Módulo de catálogo inmutable: lee aqorath/data/catalogo_base.json y expone helpers.
+
+Este módulo sustituye el comportamiento de permitir que el usuario cambie el catálogo:
+la fuente de verdad es aqorath/data/catalogo_base.json (controlada por el desarrollador).
+"""
+from pathlib import Path
+import json
+from typing import Optional, Dict
+
+BASE = Path(__file__).parent / "data" / "catalogo_base.json"
+_cache: Optional[Dict] = None
+
+def _load():
+    global _cache
+    if _cache is None:
+        if not BASE.exists():
+            _cache = {"version": "", "accounts": {}}
+        else:
+            _cache = json.loads(BASE.read_text(encoding="utf-8"))
+    return _cache
+
+def get_catalog_entry(code: str) -> Dict:
+    data = _load()
+    return data.get("accounts", {}).get(str(code), {})
+
+def get_name_for_code_from_catalog(code: str, prefer: Optional[str] = None) -> Optional[str]:
+    """
+    Devuelve name_osc o name_comercial desde el catálogo embebido.
+    prefer: 'osc' | 'comercial' (si es None, devuelve comercial si existe, sino osc)
+    """
+    entry = get_catalog_entry(code)
+    if not entry:
+        return None
+    if prefer == "osc":
+        return entry.get("name_osc")
+    if prefer == "comercial":
+        return entry.get("name_comercial")
+    return entry.get("name_comercial") or entry.get("name_osc")
+
